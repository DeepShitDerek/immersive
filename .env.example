# Copy to .env.local.
#
# With the two Supabase values empty, the site is static: it is built from
# portfolio.config.ts and has no workspace. With them set, content comes from
# the database and /admin is the workspace.
#
# Every NEXT_PUBLIC_* value is compiled into the JavaScript every visitor
# downloads. Nothing secret belongs in this file.

# --- Database (leave empty for a static site) ---
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The storage bucket db/schema.sql creates for uploads.
NEXT_PUBLIC_BUCKET_NAME=assets

# --- Site ---
# Where the site is served, without a trailing slash: https://example.com.
# Used for link-preview cards and canonical addresses.
NEXT_PUBLIC_SITE_URL=

# --- Optional: names. Each defaults to one built from portfolio.config.ts ---
# The browser tab title, and the description search engines show.
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_SITE_DESCRIPTION=
# What your authenticator app shows for the workspace's second factor.
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_MFA_ISSUER=

# --- Optional: contact notifications on a static site ---
# A Discord webhook the contact form posts to. Static sites only: with a
# database the notification is sent by a database trigger, and the address is
# kept in the workspace (Inbox -> Notifications) where visitors cannot read it.
# A value set here is public, and a webhook address lets anyone post to that
# channel. Set it only if you accept that.
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=

# --- Optional: development ---
# 1 records visits while running `npm run dev`, to try the analytics screens.
# Off by default, so reloading a page forty times is not forty visits.
# Never set it in production.
NEXT_PUBLIC_ANALYTICS_DEBUG=
