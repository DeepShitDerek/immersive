{
  "name": "foliokit",
  "version": "1.0.0",
  "private": true,
  "description": "A template portfolio that works out of the box. Static or dynamic, your choice.",
  "author": {
    "name": "Akshay Bharadva",
    "url": "https://github.com/akshay-bharadva"
  },
  "keywords": [
    "portfolio",
    "template",
    "nextjs",
    "supabase",
    "foliokit"
  ],
  "scripts": {
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs && node scripts/clear-fetch-cache.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/finalize-export.mjs",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,md,json,css}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:seed": "node scripts/test-sample-seed.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "check:hydration": "node scripts/check-hydration.mjs",
    "check:live-schema": "node scripts/check-live-schema.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:maps": "node scripts/check-maps.mjs",
    "check:money": "node scripts/check-money.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:immersive": "node scripts/check-immersive.mjs",
    "check:themes": "node scripts/theme-contrast.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check:radix": "node scripts/check-radix-dedupe.mjs"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-toggle-group": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@reduxjs/toolkit": "^2.2.5",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "^2.42.0",
    "@tiptap/extension-character-count": "^3.18.0",
    "@tiptap/extension-highlight": "^3.18.0",
    "@tiptap/extension-image": "^3.18.0",
    "@tiptap/extension-placeholder": "^3.18.0",
    "@tiptap/extension-table": "^3.18.0",
    "@tiptap/extension-table-cell": "^3.18.0",
    "@tiptap/extension-table-header": "^3.18.0",
    "@tiptap/extension-table-row": "^3.18.0",
    "@tiptap/extension-task-item": "^3.18.0",
    "@tiptap/extension-task-list": "^3.18.0",
    "@tiptap/extension-text-align": "^3.18.0",
    "@tiptap/extension-typography": "^3.18.0",
    "@tiptap/pm": "^3.18.0",
    "@tiptap/react": "^3.18.0",
    "@tiptap/starter-kit": "^3.18.0",
    "@xyflow/react": "^12.12.0",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.1.1",
    "gsap": "^3.15.0",
    "input-otp": "^1.2.4",
    "lenis": "^1.3.26",
    "lucide-react": "0.397.0",
    "next": "^16.3.8",
    "next-themes": "0.4.6",
    "prism-themes": "^1.9.0",
    "react": "19.3.0",
    "react-day-picker": "8.10.2",
